# Environment Variables Template for CoachFee
# Copy this file to .env and adjust variables as required

DJANGO_SECRET_KEY=your-strong-production-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database URL (Render / PostgreSQL)
# If left blank, defaults to local SQLite database (db.sqlite3)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Gateway Security (HMAC verification for webhooks)
GATEWAY_HMAC_SECRET=your-production-gateway-hmac-secret
